    "choose": {
      "tagger": "clip",
      "fingerprint": "dino_small",
      "quick_tagger": "clip",
      "_note": "Which installed model does each job. siglip2_vision (base) and siglip2_so400m are challengers: switch only after they win on TEST_DRIVE_v1 (scored, step 6)."
    },
    "sample": {
      "overview_max": 90,
      "overview_every_s": 2.0,
      "cut_fps": 3,
      "timeout_s": 300,
      "_note": "Overview: real frames decoded at real timestamps spread over the WHOLE clip (actual PTS recorded), max overview_max. Cuts: PySceneDetect on a low-res stream at cut_fps."
    },
    "cuts": {
      "detector": "AdaptiveDetector",
      "second_opinion": "transnetv2",
      "transnet_threshold": 0.5
    },
    "regimes": {
      "method": "ruptures.Pelt",
      "model": "l2",
      "jump": 1,
      "min_samples": 2,
      "penalty": 3.0,
      "_note": "Inside each shot, on normalized fingerprints. min_samples counts samples, not seconds. A shot cut is always a boundary; the minimum never erases one. Penalty to be tuned on TEST_DRIVE_v1."
    },
    "family": {
      "join_above": 0.82,
      "passes": 3,
      "frozen_pass": true,
      "min_compactness": 0.75,
      "_note": "Leader walk in drive order, then a frozen-centroid reassignment, then a compactness check (a member below min_compactness to its centre leaves as a singleton). No chain merges."
    },
